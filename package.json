{
  "name": "iol-order",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser/*.pw.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-iol-rules \"node --test tests/rules/*.test.js\"",
    "deploy:dev:firestore": "firebase deploy --only firestore --project medconf-iol-dev",
    "test:functions": "firebase emulators:exec --only firestore --project demo-iol-functions \"node --test --test-concurrency=1 tests/functions/*.test.js\"",
    "test:functions:e2e": "firebase emulators:exec --only functions,firestore,auth --project demo-iol-e2e \"node --test tests/functions-e2e/*.test.js\"",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "stamp": "node scripts/stamp-assets.mjs",
    "deploy:dev:functions": "firebase deploy --only functions --project medconf-iol-dev"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.7.0",
    "playwright-core": "^1.64.1"
  }
}
