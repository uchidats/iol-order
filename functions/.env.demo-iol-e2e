ORDER_INTAKE_ENABLED=true
ORDER_INTAKE_UNRESTRICTED=true
# 注文メールの送信(docs/order-mail.md)。エミュレータでは実際に送らない
MAIL_SENDING_ENABLED=false
# ディーラー専用画面(docs/dealer-portal.md)。エミュレータのテストでは有効にする(本番の既定は停止)
DEALER_PORTAL_ENABLED=true
# 参加の確認コードを、エミュレータではテスト用の文書に書く(demo- のプロジェクトだけで有効。本番の環境ファイルには書かない)
DEALER_JOIN_CODE_TEST_SINK=true
