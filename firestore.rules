rules_version = '2';

// iol-order Firestore Security Rules
// 方針:
//  - 既定は全拒否。施設配下のデータは「その施設の有効な所属メンバー」のみ読める。
//  - 施設管理者(admin)は同一施設の orderer 権限のメンバー・注文者・採用IOL・ディーラー設定のみ管理できる。
//  - admin 権限の付与、施設の作成・停止、マスター(iolCatalog / dealers)の変更は
//    カスタムクレーム platformAdmin(Admin SDK / サーバー側でのみ設定可能)を持つ運営者のみ。
//  - 自分自身の所属ドキュメントはクライアントから変更できない（自己昇格の防止）。
//  - 注文(orders)はクライアントから作成・変更不可（将来のCloud Functionsのみ）。
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共通関数 ----------
    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return signedIn() && request.auth.token.get('platformAdmin', false) == true;
    }

    function memberPath(fid) {
      return /databases/$(database)/documents/facilities/$(fid)/members/$(request.auth.uid);
    }

    function facilityIsActive(fid) {
      return get(/databases/$(database)/documents/facilities/$(fid)).data.status == 'active';
    }

    // 役割(functions/src/roles.js と一致させる。tests/rules-roles-sync.test.js が検証)
    //  admin    = 管理者     : すべて(施設名・所在地の変更、施設削除、管理者・副管理者の権限管理を含む)
    //  subadmin = 副管理者   : 施設設定(担当医・採用IOL・ディーラー・表示順)、利用者管理(注文者・代行入力者のみ)、注文
    //  orderer  = 注文者     : 注文
    //  proxy    = 代行入力者 : 注文(注文者と同じ権限。注文の記録で役割を区別する)
    function memberRoles() { return ['admin', 'subadmin', 'orderer', 'proxy']; }
    function managerRoles() { return ['admin', 'subadmin']; }

    // 所属（上記いずれかの role の所属ドキュメントがある）で、施設も有効。
    // 所属に有効/無効の状態はない。所属が削除されると、ログイン中のセッションでも次のリクエストから拒否される。
    function isMember(fid) {
      return signedIn()
        && exists(memberPath(fid))
        && get(memberPath(fid)).data.role in memberRoles()
        && facilityIsActive(fid);
    }

    // 管理者のみ(施設名・所在地の変更など)
    function isFacilityAdmin(fid) {
      return isMember(fid) && get(memberPath(fid)).data.role == 'admin';
    }

    // 管理者または副管理者(施設設定・利用者一覧の閲覧)
    function isFacilityManager(fid) {
      return isMember(fid) && get(memberPath(fid)).data.role in managerRoles();
    }

    // ---------- 施設設定の変更者(docs/settings-audit.md) ----------
    // 担当医・採用IOL・ディーラーの作成・更新は updatedBy(変更者の uid)を持てる。持つ場合は、ログイン中の本人の uid で、
    // updatedAt がこの書き込みの時刻(serverTimestamp)であること(他人の名前・古い値で記録できない)。
    // 担当医・ディーラーの削除は、同じ一括書き込みで deletionMarks に本人の uid と時刻を書く。
    // 移行の間は false(updatedBy・削除の記録がない旧画面の書き込みも受け付ける)。すべての画面が新しい版になったら true にする。
    function actorRequired() { return false; }

    function actorOk(d) {
      return ('updatedBy' in d)
        ? (d.updatedBy == request.auth.uid && d.updatedAt == request.time)
        : !actorRequired();
    }

    function deletionMarkOk(fid, col, id) {
      let p = /databases/$(database)/documents/facilities/$(fid)/deletionMarks/$(col + '_' + id);
      return existsAfter(p)
        ? (getAfter(p).data.deletedBy == request.auth.uid && getAfter(p).data.deletedAt == request.time)
        : !actorRequired();
    }

    function stringIn(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // 施設の位置情報（現在地による施設選択の補助用。アクセス権限の根拠にはしない）
    // location: { lat, lng } / geoRadiusM: 判定距離(m)。値は管理者が登録し、ここでは妥当な範囲かだけを検証する。
    function validGeo(d) {
      return (!('location' in d)
              || (d.location is map
                  && d.location.keys().hasOnly(['lat', 'lng'])
                  && d.location.keys().hasAll(['lat', 'lng'])
                  && d.location.lat is number && d.location.lat >= -90 && d.location.lat <= 90
                  && d.location.lng is number && d.location.lng >= -180 && d.location.lng <= 180))
          && (!('geoRadiusM' in d)
              || (d.geoRadiusM is number && d.geoRadiusM >= 10 && d.geoRadiusM <= 5000));
    }

    // 共通IOLマスターのID（src/data/iol-models.js の IOL_MODELS[].id と一致させる。tests/rules-catalog-sync.test.js が検証）
    function validCatalogIolId(v) {
      return v in [
        'jj-dib00v',
        'jj-diwxxx-toric',
        'alcon-cna0t0',
        'alcon-cna0tx-cnw0tx-toric',
        'santen-nx-70s',
        'santen-ls-313mf15',
        'santen-ls-313mf15-tx-toric',
        'nidek-nsp-2',
        'nidek-np-tx-toric',
        'hoya-xy1',
        'hoya-py-60ad',
        'alcon-mn60ma-yellow'
      ];
    }

    // メールアドレス（形式チェック）。リストは最大5件（先頭から5要素を個別に検証）
    function emailOk(v) {
      return v is string && v.size() <= 254 && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }
    function emailAt(l, i) {
      return l.size() <= i || emailOk(l[i]);
    }
    function validEmailList(l) {
      return l is list && l.size() <= 5
        && emailAt(l, 0) && emailAt(l, 1) && emailAt(l, 2) && emailAt(l, 3) && emailAt(l, 4);
    }

    function validSortOrder(d) {
      return !('sortOrder' in d) || (d.sortOrder is int && d.sortOrder >= 0 && d.sortOrder <= 100000);
    }

    // ---------- マスター ----------
    match /iolCatalog/{catalogIolId} {
      allow read: if signedIn();
      allow write: if isPlatformAdmin();
    }

    match /dealers/{dealerId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && request.auth.uid in resource.data.get('memberUids', []));
      allow write: if isPlatformAdmin();
    }

    // ---------- 施設 ----------
    match /facilities/{fid} {
      allow get: if isPlatformAdmin() || isMember(fid);
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin();
      // 施設管理者は表示名と位置情報のみ変更可（status 等は変更不可）
      allow update: if isPlatformAdmin()
        || (isFacilityAdmin(fid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'location', 'geoRadiusM', 'updatedAt'])
            && stringIn(request.resource.data.name, 1, 100)
            && validGeo(request.resource.data));
      allow delete: if false;

      // 所属メンバー
      // 所属の作成・変更・削除は、クライアントからは一切できない(運営者を除く)。
      //  - 作成: セルフ登録・招待による参加(Cloud Functions)
      //  - 削除: 施設管理者による利用者の所属削除(Cloud Functions removeMember。所属の削除と操作履歴を1トランザクションで行う)
      // 所属に有効/無効の状態はなく、削除された所属は存在しない(=アクセスできない)。
      function validMemberShape(uid) {
        return request.resource.data.keys().hasOnly(['uid', 'role', 'displayName', 'email', 'updatedAt'])
          && request.resource.data.keys().hasAll(['uid', 'role'])
          && request.resource.data.uid == uid
          && request.resource.data.role in memberRoles();
      }

      match /members/{uid} {
        // 自分の所属は読める(ログイン後の所属確認用)。他人の所属は管理者・副管理者のみ。
        allow get: if signedIn() && (request.auth.uid == uid || isFacilityManager(fid) || isPlatformAdmin());
        allow list: if isFacilityManager(fid) || isPlatformAdmin();
        allow create, update: if isPlatformAdmin() && validMemberShape(uid);
        allow delete: if isPlatformAdmin();
      }

      // 管理操作の記録（追記のみ。管理者・副管理者と運営者だけが読める。書き込みはCloud Functionsのみ＝クライアントは作成・変更・削除できない）
      match /auditLogs/{logId} {
        allow read: if isFacilityManager(fid) || isPlatformAdmin();
        allow write: if false;
      }

      // 担当医マスター（コレクション名は互換のため orderers。管理者・副管理者が変更・削除可）
      match /orderers/{id} {
        allow read: if isPlatformAdmin() || isMember(fid);
        allow create, update: if (isPlatformAdmin() || isFacilityManager(fid))
          && request.resource.data.keys().hasOnly(['facilityId', 'name', 'email', 'sortOrder', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll(['facilityId', 'name'])
          && request.resource.data.facilityId == fid
          && stringIn(request.resource.data.name, 1, 50)
          && (!('email' in request.resource.data) || emailOk(request.resource.data.email))
          && validSortOrder(request.resource.data)
          && actorOk(request.resource.data);
        // 担当医マスターは、自施設の管理者・副管理者も削除できる（所属・認証ユーザー・注文履歴には影響しない）
        allow delete: if (isPlatformAdmin() || isFacilityManager(fid)) && deletionMarkOk(fid, 'orderers', id);
      }

      // 採用IOL（ドキュメントID = 共通IOLマスターのID。マスターに無いIDは登録不可）
      match /adoptedIols/{id} {
        allow read: if isPlatformAdmin() || isMember(fid);
        allow create, update: if (isPlatformAdmin() || isFacilityManager(fid))
          && request.resource.data.keys().hasOnly(['facilityId', 'catalogIolId', 'dealerId', 'enabled', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll(['facilityId', 'catalogIolId', 'enabled'])
          && request.resource.data.facilityId == fid
          && request.resource.data.catalogIolId == id
          && validCatalogIolId(request.resource.data.catalogIolId)
          && request.resource.data.enabled is bool
          && (!('dealerId' in request.resource.data) || stringIn(request.resource.data.dealerId, 1, 100))
          && actorOk(request.resource.data);
        allow delete: if isPlatformAdmin();   // 画面からは削除しない(採用解除は enabled=false の更新)
      }

      // 施設が使うディーラー（発注先設定）。発注用メール(orderEmails)と使用報告用メール(usageReportEmails)は別管理
      match /facilityDealers/{id} {
        allow read: if isPlatformAdmin() || isMember(fid);
        allow create, update: if (isPlatformAdmin() || isFacilityManager(fid))
          && request.resource.data.keys().hasOnly(['facilityId', 'dealerId', 'name', 'mailName', 'orderEmails', 'usageReportEmails', 'sortOrder', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll(['facilityId', 'name'])
          && request.resource.data.facilityId == fid
          && stringIn(request.resource.data.name, 1, 100)
          && (!('mailName' in request.resource.data) || stringIn(request.resource.data.mailName, 0, 100))   // 注文メールの宛名(正式表記。任意)
          && (!('dealerId' in request.resource.data) || stringIn(request.resource.data.dealerId, 1, 100))
          && (!('orderEmails' in request.resource.data) || validEmailList(request.resource.data.orderEmails))
          && (!('usageReportEmails' in request.resource.data) || validEmailList(request.resource.data.usageReportEmails))
          && validSortOrder(request.resource.data)
          && actorOk(request.resource.data);
        // ディーラーに有効/無効はない。自施設の管理者・副管理者が削除できる(他施設は不可)。過去の注文に保存されたディーラー情報は注文側に残る
        allow delete: if (isPlatformAdmin() || isFacilityManager(fid)) && deletionMarkOk(fid, 'facilityDealers', id);
      }

      // 削除の記録(担当医・ディーラーを削除する一括書き込みで、本人が書く)。ID = {コレクション}_{ドキュメントID}。
      // 変更履歴のトリガーが削除の変更者を確かめるためだけに使う。クライアントからは読めず、削除もできない
      match /deletionMarks/{markId} {
        allow read, delete: if false;
        allow create, update: if (isPlatformAdmin() || isFacilityManager(fid))
          && request.resource.data.keys().hasOnly(['collection', 'docId', 'deletedBy', 'deletedAt'])
          && request.resource.data.keys().hasAll(['collection', 'docId', 'deletedBy', 'deletedAt'])
          && request.resource.data.collection in ['orderers', 'facilityDealers']
          && request.resource.data.docId is string
          && markId == request.resource.data.collection + '_' + request.resource.data.docId
          && request.resource.data.deletedBy == request.auth.uid
          && request.resource.data.deletedAt == request.time;
      }

      // 表示設定(施設ごとのIOLモデルの表示順)。順番だけの設定で、採用状態・注文内容には影響しない。
      // 読めるのは所属メンバー(注文画面が使う)、書けるのは自施設の管理者・副管理者のみ。
      match /displaySettings/{docId} {
        // memberOrder(利用者管理の表示順。所属の uid・参加待ちのIDの並び)は、利用者一覧と同じく管理者・副管理者だけが読める
        allow read: if isPlatformAdmin()
          || (docId != 'memberOrder' && isMember(fid))
          || (docId == 'memberOrder' && isFacilityManager(fid));
        allow create, update: if (isPlatformAdmin() || isFacilityManager(fid))
          && ((docId == 'iolOrder'
              && request.resource.data.keys().hasOnly(['makerOrder', 'modelOrder', 'updatedAt'])
              && request.resource.data.keys().hasAll(['makerOrder', 'modelOrder'])
              && request.resource.data.makerOrder is list && request.resource.data.makerOrder.size() <= 50
              && request.resource.data.modelOrder is list && request.resource.data.modelOrder.size() <= 200)
            || (docId == 'memberOrder'
              && request.resource.data.keys().hasOnly(['order', 'updatedAt'])
              && request.resource.data.keys().hasAll(['order'])
              && request.resource.data.order is list && request.resource.data.order.size() <= 500)
            // ヘッダーのテーマカラー(所属者が読める。背景色は明るさに関係なく可。darkText=黒い文字。項目がない既存の設定は白い文字)。初期設定に戻すときは削除
            || (docId == 'headerTheme'
              && request.resource.data.keys().hasOnly(['color', 'gradient', 'darkText', 'updatedAt'])
              && request.resource.data.keys().hasAll(['color', 'gradient'])
              && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-f]{6}$')
              && request.resource.data.gradient is bool
              && (!('darkText' in request.resource.data) || request.resource.data.darkText is bool)));
        allow delete: if isPlatformAdmin() || isFacilityManager(fid);
      }

      // 注文（サーバーのみが作成。クライアントは読取のみ）
      match /orders/{orderId} {
        allow read: if isPlatformAdmin() || isMember(fid);
        allow write: if false;

        // 注文メールの送信待ち・送信結果(宛先・本文を含む)。読めるのは管理者・副管理者と運営者。書き込みは Cloud Functions のみ
        match /mails/{mailId} {
          allow read: if isPlatformAdmin() || isFacilityManager(fid);
          allow write: if false;
        }
      }

      // 施設のメール設定(docId = 'mail'): 注文控えメール(ON/OFF・送信先1件)と署名。管理者・副管理者が読み書きできる
      match /settings/{docId} {
        allow read: if isPlatformAdmin() || isFacilityManager(fid);
        allow create, update: if (isPlatformAdmin() || isFacilityManager(fid))
          && docId == 'mail'
          && request.resource.data.keys().hasOnly(['copyEnabled', 'copyEmail', 'signature', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll(['copyEnabled'])
          && request.resource.data.copyEnabled is bool
          && (!('copyEmail' in request.resource.data) || request.resource.data.copyEmail == '' || emailOk(request.resource.data.copyEmail))
          && (request.resource.data.copyEnabled == false || ('copyEmail' in request.resource.data && emailOk(request.resource.data.copyEmail)))
          && (!('signature' in request.resource.data) || stringIn(request.resource.data.signature, 0, 500))
          && actorOk(request.resource.data);
        allow delete: if false;
      }
      // ディーラー専用画面: 施設別発注先と会社の関連付け(閲覧の許可・取消はサーバーだけが行う。施設の管理者も直接は読み書きしない)
      match /dealerPortalLinks/{localDealerId} {
        allow read, write: if false;
      }
    }

    // 施設のセルフ登録・招待参加はサーバー側(Cloud Functions / Admin SDK)専用。クライアントからは一切読み書きできない
    match /invites/{inviteId} {
      allow read, write: if false;
    }
    // 参加待ち(利用者管理の「追加」で事前登録された利用者。ドキュメントID = {施設ID}_{メールのハッシュ})。
    // 作成・変更・削除・参加の承認はサーバー(Cloud Functions)のみ。メール確認済み・30日の期限の検証もサーバーで行う。
    // 読めるのは、その施設の管理者・副管理者と運営者のみ(一覧は facilityId で絞った問い合わせだけが通る)。本人宛ての参加待ちはサーバー経由で返す。
    match /pendingMembers/{id} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.facilityId is string && isFacilityManager(resource.data.facilityId));
      allow write: if false;
    }
    match /registrationQuota/{uid} {
      allow read, write: if false;
    }
    // 新しい施設の登録申請(申請者名・メールアドレスを含む)。申請・一覧・承認・却下はサーバー(Cloud Functions)だけが行う。
    // 承認権限の確認もサーバー(運営者を含め、クライアントから直接は読み書きできない)
    match /facilityApplications/{applicationId} {
      allow read, write: if false;
    }
    // 運営者の操作履歴(申請の削除など)。Cloud Functions だけが書く。クライアントからは読み書きできない
    match /platformAuditLogs/{logId} {
      allow read, write: if false;
    }
    match /rateLimits/{id} {
      allow read, write: if false;
    }
    // ディーラー専用画面(docs/dealer-portal.md)。会社・支店・担当者・担当施設・参加待ち・閲覧許可・受信の索引・操作履歴は、
    // すべてサーバー(Cloud Functions)だけが扱う。ディーラーの担当者・施設の管理者・運営者を含め、クライアントからは読み書きできない
    // (担当者の所属は staff。既存の /{path=**}/members の規則に巻き込まないため members という名前にしない)
    match /dealerCompanies/{document=**} {
      allow read, write: if false;
    }
    match /dealerCompanyInvitations/{id} {
      allow read, write: if false;
    }
    match /dealerPortalGrants/{id} {
      allow read, write: if false;
    }
    match /dealerPortalAuditLogs/{id} {
      allow read, write: if false;
    }
    match /dealerStaffIndex/{uid} {
      allow read, write: if false;
    }

    // サービス紹介「IOL Orderについて」の本文(原稿 docs/introduction/service-introduction-web.md を、運営者が
    // scripts/publish-introduction.mjs で登録する。Admin 権限の書き込みのみ)。読めるのは platformAdmin だけ。
    // 一般公開は、運営者の承認後に introductionPublic() を true にしてデプロイしたときだけ(画面側の設定も合わせて変える)
    function introductionPublic() { return false; }
    match /platformContent/{docId} {
      allow get: if docId == 'serviceIntroduction' && (isPlatformAdmin() || introductionPublic());
      allow list, write: if false;
    }

    // 自分の所属を調べる collectionGroup クエリ用（uid == 自分 の所属ドキュメントのみ）
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
