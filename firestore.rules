rules_version = '2';

// iol-order Firestore Security Rules
// 方針:
//  - 既定は全拒否。施設配下のデータは「その施設の有効な所属メンバー」のみ読める。
//  - 施設管理者(admin)は同一施設の orderer 権限のメンバー・注文者・採用IOL・ディーラー設定のみ管理できる。
//  - admin 権限の付与、施設の作成・停止、マスター(iolCatalog / dealers)の変更は
//    カスタムクレーム platformAdmin(Admin SDK / サーバー側でのみ設定可能)を持つ運営者のみ。
//  - 自分自身の所属ドキュメントはクライアントから変更できない（自己昇格の防止）。
//  - 注文(orders)はクライアントから作成・変更不可（将来のCloud Functionsのみ）。
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共通関数 ----------
    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return signedIn() && request.auth.token.get('platformAdmin', false) == true;
    }

    function memberPath(fid) {
      return /databases/$(database)/documents/facilities/$(fid)/members/$(request.auth.uid);
    }

    function facilityIsActive(fid) {
      return get(/databases/$(database)/documents/facilities/$(fid)).data.status == 'active';
    }

    // 有効な所属（status=active かつ role が admin/orderer）で、施設も有効
    function isMember(fid) {
      return signedIn()
        && exists(memberPath(fid))
        && get(memberPath(fid)).data.status == 'active'
        && get(memberPath(fid)).data.role in ['admin', 'orderer']
        && facilityIsActive(fid);
    }

    function isFacilityAdmin(fid) {
      return isMember(fid) && get(memberPath(fid)).data.role == 'admin';
    }

    function stringIn(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // 施設の位置情報（現在地による施設選択の補助用。アクセス権限の根拠にはしない）
    // location: { lat, lng } / geoRadiusM: 判定距離(m)。値は管理者が登録し、ここでは妥当な範囲かだけを検証する。
    function validGeo(d) {
      return (!('location' in d)
              || (d.location is map
                  && d.location.keys().hasOnly(['lat', 'lng'])
                  && d.location.keys().hasAll(['lat', 'lng'])
                  && d.location.lat is number && d.location.lat >= -90 && d.location.lat <= 90
                  && d.location.lng is number && d.location.lng >= -180 && d.location.lng <= 180))
          && (!('geoRadiusM' in d)
              || (d.geoRadiusM is number && d.geoRadiusM >= 10 && d.geoRadiusM <= 5000));
    }

    // 共通IOLマスターのID（src/data/iol-models.js の IOL_MODELS[].id と一致させる。tests/rules-catalog-sync.test.js が検証）
    function validCatalogIolId(v) {
      return v in [
        'jj-dib00v',
        'jj-diwxxx-toric',
        'alcon-cna0t0',
        'alcon-cna0tx-cnw0tx-toric',
        'santen-nx-70s',
        'santen-ls-313mf15',
        'santen-ls-313mf15-tx-toric',
        'nidek-nsp-2',
        'nidek-np-tx-toric',
        'hoya-xy1',
        'hoya-py-60ad',
        'alcon-mn60ma-yellow'
      ];
    }

    // メールアドレス（形式チェック）。リストは最大5件（先頭から5要素を個別に検証）
    function emailOk(v) {
      return v is string && v.size() <= 254 && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }
    function emailAt(l, i) {
      return l.size() <= i || emailOk(l[i]);
    }
    function validEmailList(l) {
      return l is list && l.size() <= 5
        && emailAt(l, 0) && emailAt(l, 1) && emailAt(l, 2) && emailAt(l, 3) && emailAt(l, 4);
    }

    function validSortOrder(d) {
      return !('sortOrder' in d) || (d.sortOrder is int && d.sortOrder >= 0 && d.sortOrder <= 100000);
    }

    // ---------- マスター ----------
    match /iolCatalog/{catalogIolId} {
      allow read: if signedIn();
      allow write: if isPlatformAdmin();
    }

    match /dealers/{dealerId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && request.auth.uid in resource.data.get('memberUids', []));
      allow write: if isPlatformAdmin();
    }

    // ---------- 施設 ----------
    match /facilities/{fid} {
      allow get: if isPlatformAdmin() || isMember(fid);
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin();
      // 施設管理者は表示名と位置情報のみ変更可（status 等は変更不可）
      allow update: if isPlatformAdmin()
        || (isFacilityAdmin(fid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'location', 'geoRadiusM', 'updatedAt'])
            && stringIn(request.resource.data.name, 1, 100)
            && validGeo(request.resource.data));
      allow delete: if false;

      // 所属メンバー
      function validMemberShape(uid) {
        return request.resource.data.keys().hasOnly(['uid', 'role', 'status', 'displayName', 'updatedAt'])
          && request.resource.data.keys().hasAll(['uid', 'role', 'status'])
          && request.resource.data.uid == uid
          && request.resource.data.status in ['active', 'disabled'];
      }

      match /members/{uid} {
        // 自分の所属は読める（ログイン後の所属確認用）。他人の所属は施設管理者のみ。
        allow get: if signedIn() && (request.auth.uid == uid || isFacilityAdmin(fid) || isPlatformAdmin());
        allow list: if isFacilityAdmin(fid) || isPlatformAdmin();

        // admin の付与・変更・削除は運営者のみ。施設管理者は他人の orderer のみ管理可。自分自身は不可。
        allow create: if (isPlatformAdmin()
              && validMemberShape(uid) && request.resource.data.role in ['admin', 'orderer'])
          || (isFacilityAdmin(fid) && uid != request.auth.uid
              && validMemberShape(uid) && request.resource.data.role == 'orderer');
        allow update: if (isPlatformAdmin()
              && validMemberShape(uid) && request.resource.data.role in ['admin', 'orderer'])
          || (isFacilityAdmin(fid) && uid != request.auth.uid
              && resource.data.role == 'orderer'
              && validMemberShape(uid) && request.resource.data.role == 'orderer');
        allow delete: if isPlatformAdmin()
          || (isFacilityAdmin(fid) && uid != request.auth.uid && resource.data.role == 'orderer');
      }

      // 注文者（施設管理者のみ変更可。削除は運営者のみ＝通常は無効化 active=false で運用）
      match /orderers/{id} {
        allow read: if isPlatformAdmin() || isMember(fid);
        allow create, update: if (isPlatformAdmin() || isFacilityAdmin(fid))
          && request.resource.data.keys().hasOnly(['facilityId', 'name', 'email', 'active', 'sortOrder', 'updatedAt'])
          && request.resource.data.keys().hasAll(['facilityId', 'name', 'active'])
          && request.resource.data.facilityId == fid
          && stringIn(request.resource.data.name, 1, 50)
          && request.resource.data.active is bool
          && (!('email' in request.resource.data) || emailOk(request.resource.data.email))
          && validSortOrder(request.resource.data);
        allow delete: if isPlatformAdmin();
      }

      // 採用IOL（ドキュメントID = 共通IOLマスターのID。マスターに無いIDは登録不可）
      match /adoptedIols/{id} {
        allow read: if isPlatformAdmin() || isMember(fid);
        allow create, update: if (isPlatformAdmin() || isFacilityAdmin(fid))
          && request.resource.data.keys().hasOnly(['facilityId', 'catalogIolId', 'dealerId', 'enabled', 'updatedAt'])
          && request.resource.data.keys().hasAll(['facilityId', 'catalogIolId', 'enabled'])
          && request.resource.data.facilityId == fid
          && request.resource.data.catalogIolId == id
          && validCatalogIolId(request.resource.data.catalogIolId)
          && request.resource.data.enabled is bool
          && (!('dealerId' in request.resource.data) || stringIn(request.resource.data.dealerId, 1, 100));
        allow delete: if isPlatformAdmin();
      }

      // 施設が使うディーラー（発注先設定）。発注用メール(orderEmails)と使用報告用メール(usageReportEmails)は別管理
      match /facilityDealers/{id} {
        allow read: if isPlatformAdmin() || isMember(fid);
        allow create, update: if (isPlatformAdmin() || isFacilityAdmin(fid))
          && request.resource.data.keys().hasOnly(['facilityId', 'dealerId', 'name', 'orderEmails', 'usageReportEmails', 'active', 'sortOrder', 'updatedAt'])
          && request.resource.data.keys().hasAll(['facilityId', 'name', 'active'])
          && request.resource.data.facilityId == fid
          && stringIn(request.resource.data.name, 1, 100)
          && request.resource.data.active is bool
          && (!('dealerId' in request.resource.data) || stringIn(request.resource.data.dealerId, 1, 100))
          && (!('orderEmails' in request.resource.data) || validEmailList(request.resource.data.orderEmails))
          && (!('usageReportEmails' in request.resource.data) || validEmailList(request.resource.data.usageReportEmails))
          && validSortOrder(request.resource.data);
        allow delete: if isPlatformAdmin();
      }

      // 注文（サーバーのみが作成。クライアントは読取のみ）
      match /orders/{orderId} {
        allow read: if isPlatformAdmin() || isMember(fid);
        allow write: if false;
      }
    }

    // 施設のセルフ登録・招待参加はサーバー側(Cloud Functions / Admin SDK)専用。クライアントからは一切読み書きできない
    match /invites/{inviteId} {
      allow read, write: if false;
    }
    match /registrationQuota/{uid} {
      allow read, write: if false;
    }
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // 自分の所属を調べる collectionGroup クエリ用（uid == 自分 の所属ドキュメントのみ）
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
